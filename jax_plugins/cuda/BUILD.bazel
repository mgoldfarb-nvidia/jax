load(
    "//jaxlib:jax.bzl",
    "py_library_providing_imports_info",
    "pytype_library",
)
load(
    "@xla//xla/backends/gpu/libraries/cutedsl:runtime_dso.bzl",
    "normalize_runtime_dso",
)

licenses(["notice"])

package(
    default_applicable_licenses = [],
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "__init__.py",
    "plugin_pyproject.toml",
    "plugin_setup.py",
    "pyproject.toml",
    "setup.py",
])

normalize_runtime_dso(
    name = "cutedsl_runtime_dso",
    src = "@xla//xla/backends/gpu/libraries/cutedsl:cutedsl_runtime_dso",
    runtime_available = select({
        "@xla//xla/backends/gpu/libraries/cutedsl:runtime_unavailable_selected": False,
        "//conditions:default": True,
    }),
    shared = select({
        "@xla//xla/backends/gpu/libraries/cutedsl:cutedsl_runtime_shared_selected": True,
        "//conditions:default": False,
    }),
    unavailable = "@xla//xla/backends/gpu/libraries/cutedsl:runtime_unavailable",
)

cc_binary(
    name = "pjrt_c_api_gpu_plugin.so",
    data = [":cutedsl_runtime_dso"],
    linkopts = [
        "-Wl,--version-script,$(location :gpu_version_script.lds)",
        "-Wl,--no-undefined",
    ],
    linkshared = True,
    deps = [
        ":gpu_version_script.lds",
        "//jaxlib/mosaic/gpu:custom_call",
        "@xla//xla/pjrt/c:pjrt_c_api_gpu",
        "@xla//xla/service:gpu_plugin",
        "@xla//xla/stream_executor:cuda_platform",
    ],
)

py_library_providing_imports_info(
    name = "cuda_plugin",
    srcs = [
        "__init__.py",
    ],
    data = [
        ":cutedsl_runtime_dso",
        ":pjrt_c_api_gpu_plugin.so",
    ],
    lib_rule = pytype_library,
)
